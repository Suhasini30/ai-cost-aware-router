# Root .gitignore

# -----------------
# Custom / Scratch
# -----------------
scratch_*.py
scratch/
temp/
tmp/
*.tmp

# -----------------
# Python / Backend
# -----------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.env

# -----------------
# Node / Frontend
# -----------------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
.env*.local

# -----------------
# OS / Editor
# -----------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
